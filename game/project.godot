; Engine configuration file.
config_version=5

[application]

config/name="Tommy's Dino Kart"
config/version="0.1.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(1, 0.968627, 0.901961, 1)
boot_splash/show_image=true
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Dev="*res://scripts/core/dev.gd"
Lang="*res://scripts/core/lang.gd"
Controls="*res://scripts/core/controls.gd"
Settings="*res://scripts/core/settings.gd"
Roster="*res://scripts/core/roster.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"
Garage="*res://scripts/core/garage.gd"
Session="*res://scripts/core/session.gd"
Flow="*res://scripts/core/flow.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Fredoka.ttf"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[audio]

general/text_to_speech=true

[internationalization]

locale/fallback="es"
